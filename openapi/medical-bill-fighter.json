    "/api/cases/{case_id}/reduction-confirmed": {
      "post": {
        "summary": "Reduction Confirmed",
        "description": "Charge 25% of the user-confirmed reduction off-session.",
        "operationId": "reduction_confirmed_api_cases__case_id__reduction_confirmed_post",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
