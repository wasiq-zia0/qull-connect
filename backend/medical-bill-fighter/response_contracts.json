  "/api/cases/{case_id}/outcome": {
    "post": {
      "200": {
        "description": "Records the actual reduction reported by the user and quotes the fee; no charge.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "user_message": {
