    "/api/cases/{case_id}/billing/status": {
      "get": {
        "summary": "Billing Status",
        "description": "Pollable billing state: card state + whether the 25% reduction fee is settled.",
        "operationId": "billing_status_api_cases__case_id__billing_status_get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
