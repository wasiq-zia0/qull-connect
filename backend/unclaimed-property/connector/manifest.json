{
  "actions_on_install": "none",
  "auth": {
    "type": "api_key",
    "header": "Authorization",
    "scheme": "Bearer",
    "description": "Operator-provisioned opaque key for one user. No OAuth or confirmed Muse identity exchange is implemented."
  },
  "description": "Build a state-by-state checklist of official unclaimed-property portals and the information needed to search and file your own claims. The current release provides portal guides and claim preparation without collecting a fee. Paid recovery assistance is unavailable while state-specific agreements and eligibility requirements are unresolved. A proposed future fee of up to 10% is not active or authorized.",
  "display_name": "Found Money",
  "proactive_triggers": [],
  "tools": [
    {
      "name": "list_states",
      "description": "List official state portals. The user performs the search on those portals.",
      "input_schema": {
        "properties": {},
        "title": "list_statesArguments",
        "type": "object"
      }
    },
    {
      "name": "start_search",
      "description": "Prepare a free state-by-state claim guide. This does not search or file with any state.",
      "input_schema": {
        "properties": {
          "full_legal_name": {
            "title": "Full Legal Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "states": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "States",
            "type": "array"
          },
          "prior_names": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Prior Names"
          },
          "dob": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Dob"
          },
          "dob_consent": {
            "default": false,
            "title": "Dob Consent",
            "type": "boolean"
          }
        },
        "required": [
          "full_legal_name",
          "email",
          "states"
        ],
        "title": "start_searchArguments",
        "type": "object"
      }
    },
    {
      "name": "handle_life_event",
      "description": "Create a move-related draft for the authenticated user only.",
      "input_schema": {
        "properties": {
          "event_type": {
            "title": "Event Type",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          }
        },
        "required": [
          "event_type",
          "payload"
        ],
        "title": "handle_life_eventArguments",
        "type": "object"
      }
    },
    {
      "name": "complete_search",
      "description": "Complete the user's draft claim guide.",
      "input_schema": {
        "properties": {
          "search_id": {
            "title": "Search Id",
            "type": "string"
          },
          "full_legal_name": {
            "title": "Full Legal Name",
            "type": "string"
          },
          "email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Email"
          }
        },
        "required": [
          "search_id",
          "full_legal_name"
        ],
        "title": "complete_searchArguments",
        "type": "object"
      }
    },
    {
      "name": "get_search",
      "description": "Read the user's claim checklist and reported status.",
      "input_schema": {
        "properties": {
          "search_id": {
            "title": "Search Id",
            "type": "string"
          }
        },
        "required": [
          "search_id"
        ],
        "title": "get_searchArguments",
        "type": "object"
      }
    },
    {
      "name": "get_claim_pack",
      "description": "Return a claim guide and official portal. The user searches and files for free.",
      "input_schema": {
        "properties": {
          "search_id": {
            "title": "Search Id",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          }
        },
        "required": [
          "search_id",
          "state"
        ],
        "title": "get_claim_packArguments",
        "type": "object"
      }
    },
    {
      "name": "update_claim_status",
      "description": "Record the status reported by the user; no state agency is contacted.",
      "input_schema": {
        "properties": {
          "search_id": {
            "title": "Search Id",
            "type": "string"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "search_id",
          "state",
          "status"
        ],
        "title": "update_claim_statusArguments",
        "type": "object"
      }
    },
    {
      "name": "setup_billing",
      "description": "Paid assistance is unavailable pending state fee and agreement review.",
      "input_schema": {
        "properties": {
          "search_id": {
            "title": "Search Id",
            "type": "string"
          },
          "accept_fee_terms": {
            "title": "Accept Fee Terms",
            "type": "boolean"
          }
        },
        "required": [
          "search_id",
          "accept_fee_terms"
        ],
        "title": "setup_billingArguments",
        "type": "object"
      }
    },
    {
      "name": "confirm_recovery",
      "description": "Paid assistance remains blocked until state-specific fee eligibility is implemented.",
      "input_schema": {
        "properties": {
          "search_id": {
            "title": "Search Id",
            "type": "string"
          },
          "amount": {
            "title": "Amount",
            "type": "number"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "confirm_fee": {
            "title": "Confirm Fee",
            "type": "boolean"
          },
          "fee_amount_cents": {
            "title": "Fee Amount Cents",
            "type": "integer"
          }
        },
        "required": [
          "search_id",
          "amount",
          "state",
          "confirm_fee",
          "fee_amount_cents"
        ],
        "title": "confirm_recoveryArguments",
        "type": "object"
      }
    },
    {
      "name": "billing_status",
      "description": "Read the billing status for the authenticated user's search.",
      "input_schema": {
        "properties": {
          "search_id": {
            "title": "Search Id",
            "type": "string"
          }
        },
        "required": [
          "search_id"
        ],
        "title": "billing_statusArguments",
        "type": "object"
      }
    },
    {
      "name": "delete_my_data",
      "description": "Delete this user's operational records after explicit confirmation. Required payment records are retained separately.",
      "input_schema": {
        "properties": {
          "consent": {
            "title": "Consent",
            "type": "boolean"
          }
        },
        "required": [
          "consent"
        ],
        "title": "delete_my_dataArguments",
        "type": "object"
      }
    }
  ],
  "version": "1.0.0",
  "webhooks": {},
  "documentation_url": "https://qull.io/connect/found-money/api-docs/",
  "privacy_policy_url": "https://qull.io/connect/found-money/privacy/",
  "terms_of_service_url": "https://qull.io/connect/found-money/terms/",
  "support_email": "wasiq@qull.io"
}
