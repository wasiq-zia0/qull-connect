    "/api/cases/{cid}/savings-confirmed": {
      "post": {
        "summary": "Api Savings Confirmed",
        "description": "User confirms documented savings: charge the 35% fee off-session.\n\nThe fee is re-derived server-side from the STORED documented savings —\nthe request approves the exact fee quoted from that stored outcome.",
        "operationId": "api_savings_confirmed_api_cases__cid__savings_confirmed_post",
        "parameters": [
          {
            "name": "cid",
