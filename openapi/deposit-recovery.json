    "/api/life-events": {
      "post": {
        "summary": "Api Life Events",
        "description": "Receive a fan-out life event from the shared bus.\n\nService-key authenticated (see IdentityMiddleware) \u2014 there is no user\nowner here, so drafts/cases created from the bus store owner_id=NULL.\nThe promote endpoint stamps the caller's owner when the draft is claimed.\nCreates a real case when the payload is complete, otherwise a draft case\npre-filled with everything the payload provides. Always returns the\nproactive nudge in `user_message`.",
        "operationId": "api_life_events_api_life_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LifeEventIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
