{
  "actions_on_install": "none",
  "auth": {
    "type": "api_key",
    "header": "Authorization",
    "scheme": "Bearer",
    "description": "Operator-provisioned opaque key for one user. No OAuth or confirmed Muse identity exchange is implemented."
  },
  "description": "Review bill and EOB details you enter for a limited set of potential billing issues, then prepare a dispute-letter PDF to send to the billing office yourself. 25% of the actual bill reduction you report and confirm. A flagged item is not a verified error or a guaranteed saving.",
  "display_name": "Medical Bill Fighter",
  "proactive_triggers": [],
  "tools": [
    {
      "name": "create_case",
      "description": "Review user-supplied bill and EOB data for possible issues. Findings are flags for provider/insurer review, not confirmed errors.",
      "input_schema": {
        "properties": {
          "patient_name": {
            "title": "Patient Name",
            "type": "string"
          },
          "provider_name": {
            "title": "Provider Name",
            "type": "string"
          },
          "bill_date": {
            "title": "Bill Date",
            "type": "string"
          },
          "billed_patient_responsibility": {
            "title": "Billed Patient Responsibility",
            "type": "number"
          },
          "line_items": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Line Items",
            "type": "array"
          },
          "patient_email": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Patient Email"
          },
          "eob": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Eob"
          },
          "insurance_plan": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Insurance Plan"
          },
          "is_emergency": {
            "default": false,
            "title": "Is Emergency",
            "type": "boolean"
          },
          "is_out_of_network": {
            "default": false,
            "title": "Is Out Of Network",
            "type": "boolean"
          },
          "facility_in_network": {
            "default": true,
            "title": "Facility In Network",
            "type": "boolean"
          }
        },
        "required": [
          "patient_name",
          "provider_name",
          "bill_date",
          "billed_patient_responsibility",
          "line_items"
        ],
        "title": "create_caseArguments",
        "type": "object"
      }
    },
    {
      "name": "get_case",
      "description": "Read only the authenticated user's bill review.",
      "input_schema": {
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "string"
          }
        },
        "required": [
          "case_id"
        ],
        "title": "get_caseArguments",
        "type": "object"
      }
    },
    {
      "name": "pack",
      "description": "Return an authenticated PDF download endpoint after verifying this user's case and pack type. The user reviews and sends the letter.",
      "input_schema": {
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "type"
        ],
        "title": "packArguments",
        "type": "object"
      }
    },
    {
      "name": "list_packs",
      "description": "List the available letter templates; Qull does not contact providers.",
      "input_schema": {
        "properties": {},
        "title": "list_packsArguments",
        "type": "object"
      }
    },
    {
      "name": "report_outcome",
      "description": "Record the user's actual reduction and disclose the exact fee. No charge yet.",
      "input_schema": {
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "reduction_amount": {
            "title": "Reduction Amount",
            "type": "number"
          }
        },
        "required": [
          "case_id",
          "reduction_amount"
        ],
        "title": "report_outcomeArguments",
        "type": "object"
      }
    },
    {
      "name": "setup_billing",
      "description": "Return a secure hosted card-save URL and the 25% fee disclosure. No charge.",
      "input_schema": {
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "accept_fee_terms": {
            "title": "Accept Fee Terms",
            "type": "boolean"
          }
        },
        "required": [
          "case_id",
          "accept_fee_terms"
        ],
        "title": "setup_billingArguments",
        "type": "object"
      }
    },
    {
      "name": "billing_status",
      "description": "Verify payment method setup and fee status.",
      "input_schema": {
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "string"
          }
        },
        "required": [
          "case_id"
        ],
        "title": "billing_statusArguments",
        "type": "object"
      }
    },
    {
      "name": "confirm_reduction_charge",
      "description": "Charge 25% of the recorded reduction only after the user explicitly consents to the displayed fee.",
      "input_schema": {
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "confirm_fee": {
            "title": "Confirm Fee",
            "type": "boolean"
          },
          "fee_amount_cents": {
            "title": "Fee Amount Cents",
            "type": "integer"
          }
        },
        "required": [
          "case_id",
          "confirm_fee",
          "fee_amount_cents"
        ],
        "title": "confirm_reduction_chargeArguments",
        "type": "object"
      }
    },
    {
      "name": "start_bill_check",
      "description": "Start a conversational bill review using only the data supplied by this user.",
      "input_schema": {
        "properties": {
          "payload": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Payload"
          }
        },
        "title": "start_bill_checkArguments",
        "type": "object"
      }
    },
    {
      "name": "answer_question",
      "description": "Answer the next bill-review intake question.",
      "input_schema": {
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "string"
          },
          "answer": {
            "title": "Answer",
            "type": "string"
          }
        },
        "required": [
          "case_id",
          "answer"
        ],
        "title": "answer_questionArguments",
        "type": "object"
      }
    },
    {
      "name": "fee_quote",
      "description": "Read the exact USD fee on the case's stored reduction before asking for payment consent.",
      "input_schema": {
        "properties": {
          "case_id": {
            "title": "Case Id",
            "type": "string"
          }
        },
        "required": [
          "case_id"
        ],
        "title": "fee_quoteArguments",
        "type": "object"
      }
    },
    {
      "name": "delete_my_data",
      "description": "Delete this user's operational records after explicit confirmation. Required payment records are retained separately.",
      "input_schema": {
        "properties": {
          "consent": {
            "title": "Consent",
            "type": "boolean"
          }
        },
        "required": [
          "consent"
        ],
        "title": "delete_my_dataArguments",
        "type": "object"
      }
    }
  ],
  "version": "1.0.0",
  "webhooks": {},
  "documentation_url": "https://qull.io/connect/medical-bill-fighter/api-docs/",
  "privacy_policy_url": "https://qull.io/connect/medical-bill-fighter/privacy/",
  "terms_of_service_url": "https://qull.io/connect/medical-bill-fighter/terms/",
  "support_email": "wasiq@qull.io"
}
