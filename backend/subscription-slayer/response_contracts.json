                  "type": "boolean"
                },
                "service": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "user_message": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "example": {
              "ok": true,
              "service": "subscription-slayer",
              "version": "0.2.0",
              "user_message": "Subscription Slayer is awake and ready to hunt down your recurring charges."
            }
          }
        }
      }
    }
