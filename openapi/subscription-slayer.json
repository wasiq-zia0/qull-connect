  "components": {
    "schemas": {
      "BillingSetupRequest": {
        "properties": {
          "accept_fee_terms": {
            "type": "boolean",
            "const": true,
            "title": "Accept Fee Terms"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 200,
            "title": "Email",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accept_fee_terms",
          "name"
        ],
        "title": "BillingSetupRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LifeEventRequest": {
        "properties": {
          "event_type": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_type"
        ],
        "title": "LifeEventRequest"
      },
      "ManualSubscription": {
        "properties": {
          "merchant": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Merchant"
          },
          "amount": {
            "type": "number",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "EUR",
              "GBP",
              "CAD"
            ],
            "title": "Currency",
            "default": "USD"
          },
          "frequency": {
            "type": "string",
            "enum": [
              "monthly",
              "yearly"
            ],
            "title": "Frequency",
            "default": "monthly"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "merchant",
          "amount"
        ],
        "title": "ManualSubscription"
      },
      "Receipt": {
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 500,
            "title": "Subject",
            "default": ""
          },
          "sender": {
            "type": "string",
            "maxLength": 500,
            "title": "Sender",
            "default": ""
          },
          "snippet": {
            "type": "string",
            "maxLength": 2000,
            "title": "Snippet",
            "default": ""
          },
          "body": {
            "type": "string",
            "maxLength": 8000,
            "title": "Body",
            "default": ""
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "title": "Date"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "date"
        ],
        "title": "Receipt"
      },
      "ReceiptImport": {
        "properties": {
          "receipts": {
            "items": {
              "$ref": "#/components/schemas/Receipt"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Receipts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "receipts"
        ],
        "title": "ReceiptImport"
      },
      "SavingsConfirmRequest": {
        "properties": {
          "fee_amount_cents": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Fee Amount Cents"
          },
          "confirm_fee": {
            "type": "boolean",
            "const": true,
            "title": "Confirm Fee"
          },
          "subscription_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Subscription Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fee_amount_cents",
          "confirm_fee",
          "subscription_ids"
        ],
        "title": "SavingsConfirmRequest"
      },
      "SavingsQuoteRequest": {
        "properties": {
          "subscription_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Subscription Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "subscription_ids"
        ],
        "title": "SavingsQuoteRequest"
      },
      "ScanRequest": {
        "properties": {
          "source": {
            "type": "string",
            "title": "Source",
            "description": "'gmail' or 'fixtures'",
            "default": "gmail"
          },
          "max": {
            "type": "integer",
            "maximum": 500.0,
            "minimum": 1.0,
            "title": "Max",
            "default": 100
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ScanRequest"
      },
      "SubscriptionUpdate": {
        "properties": {
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "savings_monthly": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Savings Monthly"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SubscriptionUpdate"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "UserApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Qull per-user API key",
        "description": "An operator-provisioned opaque API key belonging to one customer. Never use a Stripe secret key here."
      }
    }
  },
  "security": [
    {
      "UserApiKey": []
    }
  ]
