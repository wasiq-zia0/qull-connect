  "components": {
    "schemas": {
      "BillingConsent": {
        "properties": {
          "accept_fee_terms": {
            "type": "boolean",
            "const": true,
            "title": "Accept Fee Terms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accept_fee_terms"
        ],
        "title": "BillingConsent"
      },
      "ChargeConsent": {
        "properties": {
          "fee_amount_cents": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Fee Amount Cents"
          },
          "confirm_fee": {
            "type": "boolean",
            "const": true,
            "title": "Confirm Fee",
            "description": "Explicit permission to charge the disclosed fee for this record."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fee_amount_cents",
          "confirm_fee"
        ],
        "title": "ChargeConsent"
      },
      "ChecklistItemUpdate": {
        "properties": {
          "item_id": {
            "type": "integer",
            "title": "Item Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "pending | done | na"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "item_id",
          "status"
        ],
        "title": "ChecklistItemUpdate"
      },
      "ChecklistPatch": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ChecklistItemUpdate"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ChecklistPatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LifeEventIn": {
        "properties": {
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_type"
        ],
        "title": "LifeEventIn"
      },
      "MoveIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Email"
          },
          "old_address": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Old Address"
          },
          "new_address": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "New Address"
          },
          "move_date": {
            "type": "string",
            "format": "date",
            "title": "Move Date"
          },
          "state": {
            "type": "string",
            "maxLength": 2,
            "minLength": 2,
            "title": "State",
            "description": "2-letter US state / DC code for the NEW address (DMV + voter rules)"
          },
          "draft_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Draft Id",
            "description": "Draft move id from POST /api/life-events to upgrade in place"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "email",
          "old_address",
          "new_address",
          "move_date",
          "state"
        ],
        "title": "MoveIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "UserApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Qull per-user API key",
        "description": "An operator-provisioned opaque API key belonging to one customer. Never use a Stripe secret key here."
      }
    }
  },
  "security": [
    {
      "UserApiKey": []
    }
  ]
}
