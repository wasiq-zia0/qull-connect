{
  "actions_on_install": "none",
  "auth": {
    "type": "api_key",
    "header": "Authorization",
    "scheme": "Bearer",
    "description": "Operator-provisioned opaque key for one user. No OAuth or confirmed Muse identity exchange is implemented."
  },
  "description": "Identify recurring charges in receipts you provide, get merchant-specific cancellation instructions, and track the cancellations you complete. USD $10 for each completed cancellation you select and explicitly confirm for billing. No recurring Qull subscription fee.",
  "display_name": "Subscription Slayer",
  "proactive_triggers": [],
  "tools": [
    {
      "name": "scan_subscriptions",
      "description": "Run a clearly marked fixture demo. Import user-supplied receipts for real detection; Gmail OAuth is not connected.",
      "input_schema": {
        "properties": {
          "source": {
            "default": "fixtures",
            "title": "Source",
            "type": "string"
          },
          "max_results": {
            "default": 100,
            "title": "Max Results",
            "type": "integer"
          }
        },
        "title": "scan_subscriptionsArguments",
        "type": "object"
      }
    },
    {
      "name": "import_receipts",
      "description": "Detect recurring charges from receipts supplied by this user. No mailbox access.",
      "input_schema": {
        "properties": {
          "receipts": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Receipts",
            "type": "array"
          }
        },
        "required": [
          "receipts"
        ],
        "title": "import_receiptsArguments",
        "type": "object"
      }
    },
    {
      "name": "add_subscription",
      "description": "Track a recurring charge manually; the user reviews and cancels it themselves.",
      "input_schema": {
        "properties": {
          "merchant": {
            "title": "Merchant",
            "type": "string"
          },
          "amount": {
            "title": "Amount",
            "type": "number"
          },
          "currency": {
            "default": "USD",
            "title": "Currency",
            "type": "string"
          },
          "frequency": {
            "default": "monthly",
            "title": "Frequency",
            "type": "string"
          }
        },
        "required": [
          "merchant",
          "amount"
        ],
        "title": "add_subscriptionArguments",
        "type": "object"
      }
    },
    {
      "name": "list_subscriptions",
      "description": "List only the authenticated user's tracked subscriptions.",
      "input_schema": {
        "properties": {
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Status"
          }
        },
        "title": "list_subscriptionsArguments",
        "type": "object"
      }
    },
    {
      "name": "update_subscription",
      "description": "Record the user's cancellation status and monthly saving; does not cancel with a merchant.",
      "input_schema": {
        "properties": {
          "subscription_id": {
            "title": "Subscription Id",
            "type": "integer"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Status"
          },
          "savings_monthly": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Savings Monthly"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Notes"
          }
        },
        "required": [
          "subscription_id"
        ],
        "title": "update_subscriptionArguments",
        "type": "object"
      }
    },
    {
      "name": "get_cancel_pack",
      "description": "Get a cancellation guide; the user completes the merchant's steps.",
      "input_schema": {
        "properties": {
          "subscription_id": {
            "title": "Subscription Id",
            "type": "integer"
          }
        },
        "required": [
          "subscription_id"
        ],
        "title": "get_cancel_packArguments",
        "type": "object"
      }
    },
    {
      "name": "setup_billing",
      "description": "Return a secure hosted card-save URL and the $10 per cancellation fee disclosure. No charge.",
      "input_schema": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "accept_fee_terms": {
            "title": "Accept Fee Terms",
            "type": "boolean"
          },
          "email": {
            "default": "",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "name",
          "accept_fee_terms"
        ],
        "title": "setup_billingArguments",
        "type": "object"
      }
    },
    {
      "name": "billing_status",
      "description": "Verify whether the authenticated user's payment method setup is complete.",
      "input_schema": {
        "properties": {},
        "title": "billing_statusArguments",
        "type": "object"
      }
    },
    {
      "name": "confirm_savings",
      "description": "Charge $10 per completed cancellation only after the user explicitly agrees to the displayed fee.",
      "input_schema": {
        "properties": {
          "subscription_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Subscription Ids",
            "type": "array"
          },
          "confirm_fee": {
            "title": "Confirm Fee",
            "type": "boolean"
          },
          "fee_amount_cents": {
            "title": "Fee Amount Cents",
            "type": "integer"
          }
        },
        "required": [
          "subscription_ids",
          "confirm_fee",
          "fee_amount_cents"
        ],
        "title": "confirm_savingsArguments",
        "type": "object"
      }
    },
    {
      "name": "fee_quote",
      "description": "Read the exact USD fee for a batch of completed cancellations before asking for payment consent.",
      "input_schema": {
        "properties": {
          "subscription_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Subscription Ids",
            "type": "array"
          }
        },
        "required": [
          "subscription_ids"
        ],
        "title": "fee_quoteArguments",
        "type": "object"
      }
    },
    {
      "name": "delete_my_data",
      "description": "Delete this user's operational records after explicit confirmation. Required payment records are retained separately.",
      "input_schema": {
        "properties": {
          "consent": {
            "title": "Consent",
            "type": "boolean"
          }
        },
        "required": [
          "consent"
        ],
        "title": "delete_my_dataArguments",
        "type": "object"
      }
    }
  ],
  "version": "1.0.0",
  "webhooks": {},
  "documentation_url": "https://qull.io/connect/subscription-slayer/api-docs/",
  "privacy_policy_url": "https://qull.io/connect/subscription-slayer/privacy/",
  "terms_of_service_url": "https://qull.io/connect/subscription-slayer/terms/",
  "support_email": "wasiq@qull.io"
}
