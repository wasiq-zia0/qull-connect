              },
              "additionalProperties": true
            },
            "example": {
              "cancel_pack": {
                "merchant": "Netflix",
                "curated": true,
                "cancel_url": "https://www.netflix.com/cancelplan",
                "steps": [
                  "Go to netflix.com/cancelplan and sign in.",
                  "Click Cancel Membership.",
                  "Click Finish Cancellation and confirm.",
                  "Save the confirmation email; you keep access until the end of the billing period."
                ],
                "difficulty": "easy",
                "notes": "If billed via Apple/Google Play, cancel in that platform's subscription settings instead."
