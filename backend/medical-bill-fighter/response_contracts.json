          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean"
                },
                "service": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "example": {
              "ok": true,
              "service": "medical-bill-fighter"
            }
          }
        }
      }
    }
  },
  "/api/cases": {
    "post": {
      "201": {
        "description": "Creates a bill review with possible issues for provider/insurer review. Findings do not prove a billing error.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "user_message": {
                  "type": "string"
                },
                "case_id": {
                  "type": "string"
                },
                "findings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "rule": {
                        "type": "string"
                      },
                      "severity": {
                        "type": "string"
                      },
                      "line_refs": {
                        "type": "array",
                        "items": {
                          "type": "integer"
                        }
                      },
                      "explanation": {
                        "type": "string"
                      },
                      "suggested_action": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": true
                  }
                },
                "findings_count": {
                  "type": "integer"
                },
                "legal_notice": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "example": {
              "user_message": "I went through your $500 bill and flagged 1 thing(s) to discuss with your provider or insurer. These flags do not establish an error. Would you like a letter template?",
              "case_id": "a1b2c3d4e5f6",
              "findings": [
                {
                  "rule": "duplicate_line_items",
                  "severity": "warning",
                  "line_refs": [
                    0,
                    1
                  ],
                  "explanation": "Code 99213 at $250.00 appears 2 times (lines [1, 2]). This may indicate the same charge was billed more than once.",
                  "suggested_action": "Ask the provider to confirm whether the service was actually performed multiple times; if not, request removal of the duplicate charge(s)."
                },
                {
                  "rule": "prompt_pay_suggestion",
                  "severity": "info",
                  "line_refs": [],
                  "explanation": "For this $500.00 balance, you can ask whether the provider offers payment assistance or a discount. No discount is promised. This is a discussion opportunity, not a billing error.",
                  "suggested_action": "Use the negotiation script pack to ask the billing department about a prompt-pay discount before paying the full amount."
                }
              ],
              "findings_count": 2,
              "legal_notice": "Template automation — NOT legal advice. Review before sending."
            }
          }
        }
      }
    }
  },
