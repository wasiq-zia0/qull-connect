    "/api/matches/{match_id}/billing/setup": {
      "post": {
        "summary": "Billing Setup",
        "description": "Create a Stripe customer + SetupIntent so the user can save a card.\n\nThe response carries an explicit fee disclosure BEFORE any card is saved:\n20% of the confirmed payout, charged only if the user confirms the payout.",
