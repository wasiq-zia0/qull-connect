{
  "openapi": "3.1.0",
  "info": {
    "title": "Unclaimed Property Connector",
    "description": "Qull Connect API. Supply a per-user API key in Authorization: Bearer <key>. Keys identify one customer; arbitrary platform/user-id headers are not accepted. Payment setup opens hosted Stripe Checkout and does not charge a service fee. Use the record's billing/status operation to verify setup, then explicitly authorize the applicable fee. See the linked guide for workflow and service limits.",
    "version": "1.0.0",
    "contact": {
      "name": "Qull, Inc.",
      "email": "wasiq@qull.io"
    }
  },
  "servers": [
    {
      "url": "https://5.78.152.6.nip.io/unclaimed-property"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Public process-liveness response; does not establish payment or launch readiness.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "service": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "states": {
                      "type": "integer"
                    },
                    "user_message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                },
                "example": {
                  "ok": true,
                  "service": "unclaimed-property",
                  "version": "0.2.0",
                  "states": 51,
                  "user_message": "Unclaimed-property lookup is up, covering all 50 states plus DC."
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/states": {
      "get": {
        "summary": "List States",
        "operationId": "list_states_api_states_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response List States Api States Get"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired or disabled per-user API key."
          },
          "413": {
            "description": "Request body exceeds the configured limit."
          },
          "429": {
            "description": "Request rate limit exceeded. Wait for the Retry-After interval."
          }
        }
      }
    },
    "/api/life-events": {
      "post": {
        "summary": "Receive Life Event",
        "description": "Receive a fanned-out life event from the shared bus.\n\nGolden path entry point: a 'move' event arrives -> draft search is created\nwith from/to states pre-filled -> the response's user_message is the\nproactive nudge the agent speaks to the user.",
        "operationId": "receive_life_event_api_life_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LifeEvent"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Creates a draft bound to the authenticated user; no cross-connector data sharing.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "search_id": {
                      "type": "string"
                    },
                    "draft": {
                      "type": "boolean"
                    },
                    "states": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "fanned_out_note": {
                      "type": "string"
                    },
                    "user_message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                },
                "example": {
                  "search_id": "a1b2c3d4e5f6",
                  "draft": true,
                  "states": [
                    "Texas",
                    "California"
                  ],
                  "fanned_out_note": "This event is stored only for the authenticated user in this connector.",
                  "user_message": "You just moved, and states often hold unclaimed money under old addresses. I can prepare a guide to help you search Texas and California. Reply with the name you want to use in the guide."
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired or disabled per-user API key."
          },
          "413": {
            "description": "Request body exceeds the configured limit."
          },
          "429": {
            "description": "Request rate limit exceeded. Wait for the Retry-After interval."
          }
        }
      }
    },
    "/api/searches": {
      "post": {
        "summary": "Create Search",
        "operationId": "create_search_api_searches_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IntakeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Creates a free claim guide and user-maintained checklist; no state database is searched.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "search_id": {
                      "type": "string"
                    },
                    "claimant": {
                      "type": "string"
                    },
                    "states": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "abbr": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "portal_url": {
                            "type": "string"
                          },
                          "reference_needs_review": {
                            "type": "boolean"
                          },
                          "status": {
                            "type": "string"
                          },
                          "claim_pack": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": true
                      }
                    },
                    "fanout": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "user_message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                },
                "example": {
                  "search_id": "a1b2c3d4e5f6",
                  "claimant": "Example User",
                  "states": [
                    {
                      "abbr": "CA",
                      "name": "California",
                      "portal_url": "https://unclaimed.org/",
                      "reference_needs_review": true,
                      "status": "not_started",
                      "claim_pack": "/api/searches/a1b2c3d4e5f6/claim-pack?state=CA"
                    }
                  ],
                  "fanout": null,
                  "user_message": "Done — I've prepared claim packs for California. Each pack has the portal link, step-by-step filing instructions, and your cover sheet. Want to walk through the first one?"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, expired or disabled per-user API key."
          },
          "413": {
            "description": "Request body exceeds the configured limit."
          },
          "429": {
            "description": "Request rate limit exceeded. Wait for the Retry-After interval."
          }
        }
      }
    },
