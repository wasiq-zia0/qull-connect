  "components": {
    "schemas": {
      "BillingConsentIn": {
        "properties": {
          "accept_fee_terms": {
            "type": "boolean",
            "const": true,
            "title": "Accept Fee Terms",
            "description": "The user accepted the disclosed fee terms before opening Stripe checkout."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accept_fee_terms"
        ],
        "title": "BillingConsentIn"
      },
      "CaseIn": {
        "properties": {
          "tenant_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Tenant Name"
          },
          "tenant_forwarding_address": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Tenant Forwarding Address"
          },
          "state": {
            "type": "string",
            "maxLength": 2,
            "minLength": 2,
            "title": "State",
            "description": "US state abbreviation"
          },
          "move_out": {
            "type": "string",
            "format": "date",
            "title": "Move Out",
            "description": "Date you vacated and surrendered possession of the rental property."
          },
          "tenancy_end": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenancy End",
            "description": "Date the tenancy legally ended; required for a Connecticut deadline estimate."
          },
          "forwarding_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Forwarding Date",
            "description": "Date the landlord received your written forwarding address, not merely the date you sent it."
          },
          "deposit": {
            "type": "number",
            "maximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Deposit"
          },
          "landlord_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Landlord Name"
          },
          "landlord_address": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Landlord Address"
          },
          "rental_address": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Rental Address"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tenant_name",
          "tenant_forwarding_address",
          "state",
          "move_out",
          "deposit",
          "landlord_name",
          "landlord_address",
          "rental_address"
        ],
        "title": "CaseIn"
      },
      "DeleteDataIn": {
        "properties": {
          "confirm_delete": {
            "type": "boolean",
            "const": true,
            "title": "Confirm Delete",
            "description": "The user explicitly confirms deleting their local records and generated documents."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirm_delete"
        ],
        "title": "DeleteDataIn"
      },
      "FeeQuoteIn": {
        "properties": {
          "amount_recovered": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Recovered",
            "description": "The actual recovered amount to quote; this operation does not charge."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount_recovered"
        ],
        "title": "FeeQuoteIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LetterStatusIn": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "sent-confirmed-by-user"
            ],
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "LetterStatusIn",
        "description": "The user reviews the prepared demand letter, then confirms it was sent."
      },
      "LifeEventIn": {
        "properties": {
          "event_type": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_type"
        ],
        "title": "LifeEventIn"
      },
      "PromoteIn": {
        "properties": {
          "tenant_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Name"
          },
          "tenant_forwarding_address": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Forwarding Address"
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "move_out": {
            "anyOf": [
              {
