  "components": {
    "schemas": {
      "ConfirmDraft": {
        "properties": {
          "employee_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Employee Name"
          },
          "employer_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
