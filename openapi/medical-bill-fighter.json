              }
            }
          }
        }
      }
    },
    "/api/cases/{case_id}/pack": {
      "get": {
        "summary": "Get Pack",
        "operationId": "get_pack_api_cases__case_id__pack_get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": true,
            "schema": {
              "enum": [
                "dispute",
                "itemized",
                "assistance",
                "negotiate"
              ],
              "type": "string",
              "description": "dispute|itemized|assistance|negotiate",
              "title": "Type"
            },
            "description": "dispute|itemized|assistance|negotiate"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/packs": {
      "get": {
        "summary": "List Packs",
        "operationId": "list_packs_api_packs_get",
