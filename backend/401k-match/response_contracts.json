  "/api/plans/{plan_id}/billing/setup": {
    "post": {
      "200": {
        "description": "Returns a hosted card-save URL for a one-time $99 purchase; no subscription. Processor URL/IDs are illustrative.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "plan_id": {
                  "type": "string"
                },
                "stripe_customer_id": {
                  "type": "string"
                },
                "setup_intent_id": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "client_secret": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "setup_url": {
                  "type": "string"
                },
                "checkout_session_id": {
                  "type": "string"
                },
                "fee_disclosure": {
                  "type": "string"
                },
                "user_message": {
                  "type": "string"
                },
                "note": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "example": {
              "plan_id": "a1b2c3d4e5f6",
              "stripe_customer_id": "cus_example",
              "setup_intent_id": null,
              "client_secret": null,
              "setup_url": "https://checkout.stripe.com/example",
              "checkout_session_id": "cs_example",
              "fee_disclosure": "You will be charged a one-time $99.00 for this match analysis and fix plan. There is no subscription or automatic renewal. Charged only after you confirm.",
              "user_message": "Your card setup is ready — saving a card now costs nothing. You will be charged a one-time $99.00 for this match analysis and fix plan. There is no subscription or automatic renewal. Charged only after you confirm. Ready to save your card?",
              "note": "Open setup_url to save a payment method securely, then return and check billing/status. Saving a card does not authorize the $99 fee."
            }
          }
        }
      }
    }
  },
