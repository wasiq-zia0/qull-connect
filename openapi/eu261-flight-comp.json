  "components": {
    "schemas": {
      "BillingConsentIn": {
        "properties": {
          "accept_fee_terms": {
            "type": "boolean",
            "const": true,
            "title": "Accept Fee Terms",
            "description": "The user accepted the disclosed fee terms before opening Stripe checkout."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accept_fee_terms"
        ],
        "title": "BillingConsentIn"
      },
      "ClaimIn": {
        "properties": {
          "passenger_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Passenger Name"
          },
          "passenger_email": {
            "type": "string",
            "format": "email",
            "title": "Passenger Email"
          },
          "flight_number": {
            "type": "string",
            "maxLength": 10,
            "minLength": 2,
            "title": "Flight Number"
          },
          "flight_date": {
            "type": "string",
            "title": "Flight Date",
            "description": "Flight date, YYYY-MM-DD"
          },
          "airline": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Airline"
          },
          "airline_eu_licensed": {
            "type": "boolean",
            "title": "Airline Eu Licensed",
            "description": "True if the carrier is licensed in the EU/EEA",
            "default": false
          },
          "from_iata": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "From Iata",
            "description": "Departure airport IATA code"
          },
          "to_iata": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "To Iata",
            "description": "Arrival airport IATA code"
          },
          "distance_km": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Distance Km",
            "description": "Great-circle distance in km; used only if an airport code is unknown"
          },
          "disruption": {
            "type": "string",
            "enum": [
              "delay",
              "cancellation",
              "denied_boarding"
            ],
            "title": "Disruption"
          },
          "scheduled_arrival": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scheduled Arrival",
            "description": "Scheduled arrival, ISO datetime"
          },
          "actual_arrival": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Arrival",
            "description": "Actual arrival, ISO datetime"
          },
          "arrival_delay_h": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Arrival Delay H",
            "description": "Arrival delay in hours"
          },
          "notice_days": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Notice Days",
            "description": "Cancellation notice, days before departure"
          },
          "rerouted": {
            "type": "boolean",
            "title": "Rerouted",
            "default": false
          },
          "reroute_dep_early_h": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Reroute Dep Early H"
          },
          "reroute_arr_delay_h": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Reroute Arr Delay H"
          },
          "denied_boarding_involuntary": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Denied Boarding Involuntary"
          },
          "valid_travel_documents": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid Travel Documents"
          },
          "extraordinary_circumstances": {
            "type": "boolean",
            "title": "Extraordinary Circumstances",
            "description": "True if the airline claims extraordinary circumstances",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "passenger_name",
          "passenger_email",
          "flight_number",
          "flight_date",
          "airline",
          "from_iata",
          "to_iata",
          "disruption"
        ],
        "title": "ClaimIn"
      },
      "DeleteDataIn": {
        "properties": {
          "confirm_delete": {
            "type": "boolean",
            "const": true,
            "title": "Confirm Delete",
            "description": "The user explicitly confirms deleting their local records and generated documents."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirm_delete"
        ],
        "title": "DeleteDataIn"
      },
      "FeeQuoteIn": {
        "properties": {
          "amount_eur": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Eur",
            "description": "The actual recovered amount to quote; this operation does not charge."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount_eur"
        ],
        "title": "FeeQuoteIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LifeEventIn": {
        "properties": {
          "event_type": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_type"
        ],
        "title": "LifeEventIn"
      },
      "PayoutIn": {
        "properties": {
          "confirm_fee": {
            "type": "boolean",
            "const": true,
            "title": "Confirm Fee",
            "description": "The user explicitly approved this exact fee after reviewing it."
          },
          "fee_amount_cents": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 1.0,
            "title": "Fee Amount Cents",
            "description": "The exact disclosed fee approved by the user, in cents."
          },
          "amount_eur": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Eur",
            "description": "Airline payout the user confirms they received"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirm_fee",
          "fee_amount_cents",
          "amount_eur"
        ],
        "title": "PayoutIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "UserApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Qull per-user API key",
        "description": "An operator-provisioned opaque API key belonging to one customer. Never use a Stripe secret key here."
      }
    }
  },
  "security": [
    {
      "UserApiKey": []
    }
  ]
}
