    "/api/cases/{case_id}/recovery-confirmed": {
      "post": {
        "summary": "Recovery Confirmed",
        "description": "User confirms wages were recovered; charge the 25% contingency fee\noff-session against the saved card.\n\nThe charge always goes to the case's STORED stripe_customer_id \u2014 the\nrequest carries only the recovered amount, never card details. The fee is\n25% of the asserted recovery, sanity-bounded at 2x the wages owed stored\non the case: a larger assertion is rejected (400) rather than charged.",
        "operationId": "recovery_confirmed_api_cases__case_id__recovery_confirmed_post",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
