  "components": {
    "schemas": {
      "BillingConsentIn": {
        "properties": {
          "accept_fee_terms": {
            "type": "boolean",
            "const": true,
            "title": "Accept Fee Terms",
            "description": "The user accepted the disclosed fee terms before opening Stripe checkout."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accept_fee_terms"
        ],
        "title": "BillingConsentIn"
      },
      "CaseIn": {
        "properties": {
          "provider": {
            "type": "string",
            "maxLength": 120,
            "minLength": 2,
            "title": "Provider",
            "description": "e.g. Comcast, Spectrum, AT&T, Verizon, Cox"
          },
          "service_type": {
            "type": "string",
            "enum": [
              "internet",
              "cable",
              "phone",
              "bundle"
            ],
            "title": "Service Type",
            "description": "internet, cable, phone, or bundle"
          },
          "current_monthly_bill": {
            "type": "number",
            "maximum": 100000.0,
            "exclusiveMinimum": 0.0,
            "title": "Current Monthly Bill",
            "description": "Current bill in USD/month"
          },
          "prior_monthly_bill": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Prior Monthly Bill",
            "description": "What you used to pay (optional; enables spike detection)"
          },
          "promo_end_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Promo End Date",
            "description": "Contract/promotion end date (YYYY-MM-DD)"
          },
          "account_tenure_months": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Tenure Months",
            "description": "How long you've been a customer"
          },
          "user_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "User Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "provider",
          "service_type",
          "current_monthly_bill"
        ],
        "title": "CaseIn"
      },
      "DeleteDataIn": {
        "properties": {
          "confirm_delete": {
            "type": "boolean",
            "const": true,
            "title": "Confirm Delete",
            "description": "The user explicitly confirms deleting their local records and generated documents."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirm_delete"
        ],
        "title": "DeleteDataIn"
      },
      "FeeConsentIn": {
        "properties": {
          "confirm_fee": {
            "type": "boolean",
            "const": true,
            "title": "Confirm Fee",
            "description": "The user explicitly approved this exact fee after reviewing it."
          },
          "fee_amount_cents": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 1.0,
            "title": "Fee Amount Cents",
            "description": "The exact disclosed fee approved by the user, in cents."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirm_fee",
          "fee_amount_cents"
        ],
        "title": "FeeConsentIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LifeEventIn": {
        "properties": {
          "event_type": {
            "type": "string",
            "minLength": 1,
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_type"
        ],
        "title": "LifeEventIn"
      },
      "OutcomeIn": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "False if negotiation produced no savings",
            "default": true
          },
          "new_monthly_bill": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "New Monthly Bill",
            "description": "Negotiated monthly bill in USD"
          },
          "months_locked": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 36.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Months Locked",
            "description": "Months the new rate is locked"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "OutcomeIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "UserApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Qull per-user API key",
        "description": "An operator-provisioned opaque API key belonging to one customer. Never use a Stripe secret key here."
      }
    }
  },
  "security": [
    {
      "UserApiKey": []
    }
  ]
}
