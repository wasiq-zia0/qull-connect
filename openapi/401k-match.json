{
  "openapi": "3.1.0",
  "info": {
    "title": "401k-match API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/life-events": {
      "post": {
        "summary": "Receive Life Event",
        "description": "Receive a fanned-out life event from the shared bus.\n\njob_change -> start a draft plan and return the proactive nudge.",
        "operationId": "receive_life_event_api_life_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LifeEventIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/plans": {
      "post": {
        "summary": "Create Plan",
        "description": "Advanced path: full intake in one call. Plan stored; pack locked.",
        "operationId": "create_plan_api_plans_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/plans/draft": {
      "post": {
        "summary": "Start Draft",
        "description": "Golden path: start the conversational intake. Returns the first question.",
        "operationId": "start_draft_api_plans_draft_post",
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/plans/draft/{draft_id}/answer": {
      "post": {
        "summary": "Answer Draft",
        "description": "Answer the current draft question; advances the conversation or finishes the plan.",
        "operationId": "answer_draft_api_plans_draft__draft_id__answer_post",
        "parameters": [
          {
            "name": "draft_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Draft Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftAnswerIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/plans/{plan_id}": {
      "get": {
        "summary": "Get Plan Summary",
        "operationId": "get_plan_summary_api_plans__plan_id__get",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Plan Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/plans/{plan_id}/billing/setup": {
      "post": {
        "summary": "Billing Setup",
        "description": "Create the Stripe customer + SetupIntent so the user can save a card.",
        "operationId": "billing_setup_api_plans__plan_id__billing_setup_post",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Plan Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BillingSetupIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/plans/{plan_id}/billing/status": {
      "get": {
        "summary": "Billing Status",
        "description": "Pollable billing state: card state + whether the $99/year fee is settled.",
        "operationId": "billing_status_api_plans__plan_id__billing_status_get",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Plan Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/plans/{plan_id}/pay": {
      "post": {
        "summary": "Pay",
        "description": "Charge the flat $99/year fee off-session against the saved card.",
        "operationId": "pay_api_plans__plan_id__pay_post",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Plan Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/plans/{plan_id}/pack": {
      "get": {
        "summary": "Get Pack",
        "description": "Full fix plan. Locked (402) until the $99/year fee is paid.",
        "operationId": "get_pack_api_plans__plan_id__pack_get",
        "parameters": [
          {
            "name": "plan_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Plan Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BillingSetupIn": {
        "properties": {
          "email": {
            "type": "string",
            "title": "Email",
            "default": ""
          }
        },
        "type": "object",
        "title": "BillingSetupIn"
      },
      "DraftAnswerIn": {
        "properties": {
          "answer": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "DraftAnswerIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LifeEventIn": {
        "properties": {
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "event_type"
        ],
        "title": "LifeEventIn"
      },
      "PlanIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "description": "Plan holder name"
          },
          "salary": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Salary",
            "description": "Annual gross salary in dollars"
          },
          "pay_frequency": {
            "type": "string",
            "enum": [
              "weekly",
              "biweekly",
              "semimonthly",
              "monthly"
            ],
            "title": "Pay Frequency"
          },
          "current_contrib_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Current Contrib Pct",
            "description": "Current per-paycheck contribution as % of salary"
          },
          "match_pct": {
            "type": "number",
            "maximum": 200.0,
            "minimum": 0.0,
            "title": "Match Pct",
            "description": "Employer match rate, e.g. 50 = matches 50% of contributions"
          },
          "match_cap_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Match Cap Pct",
            "description": "Employer matches up to this % of salary, e.g. 6"
          },
          "true_up": {
            "type": "boolean",
            "title": "True Up",
            "description": "Employer runs a year-end true-up",
            "default": false
          },
          "new_employer": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "New Employer",
            "description": "Optional: new employer name \u2014 emits a job_change event so sibling connectors can help"
          }
        },
        "type": "object",
        "required": [
          "name",
          "salary",
          "pay_frequency",
          "current_contrib_pct",
          "match_pct",
          "match_cap_pct"
        ],
        "title": "PlanIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "https://5.78.152.6.nip.io/401k-match"
    }
  ]
}