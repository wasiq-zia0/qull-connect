        "operationId": "delete_my_data_api_data_delete",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Delete My Data Api Data Delete"
                }
              }
