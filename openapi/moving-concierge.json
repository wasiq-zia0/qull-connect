            "name": "move_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Move Id"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(md|pdf)$",
