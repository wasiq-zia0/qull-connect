  "components": {
    "schemas": {
      "BillingConsent": {
        "properties": {
          "accept_fee_terms": {
            "type": "boolean",
            "const": true,
            "title": "Accept Fee Terms"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accept_fee_terms"
        ],
        "title": "BillingConsent"
      },
      "CaseIntake": {
        "properties": {
          "patient_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Patient Name"
          },
          "patient_email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patient Email"
          },
          "provider_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Provider Name"
          },
          "bill_date": {
            "type": "string",
            "format": "date",
            "title": "Bill Date"
          },
          "billed_patient_responsibility": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Billed Patient Responsibility"
          },
          "line_items": {
            "items": {
              "$ref": "#/components/schemas/LineItem"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Line Items"
          },
          "eob": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EobInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "insurance_plan": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Insurance Plan"
          },
          "is_emergency": {
            "type": "boolean",
            "title": "Is Emergency",
            "default": false
          },
          "is_out_of_network": {
            "type": "boolean",
            "title": "Is Out Of Network",
            "default": false
          },
          "facility_in_network": {
            "type": "boolean",
            "title": "Facility In Network",
            "default": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "patient_name",
          "provider_name",
          "bill_date",
          "billed_patient_responsibility",
          "line_items"
        ],
        "title": "CaseIntake"
      },
      "ChargeConsent": {
        "properties": {
          "fee_amount_cents": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Fee Amount Cents"
          },
          "confirm_fee": {
            "type": "boolean",
            "const": true,
            "title": "Confirm Fee",
            "description": "Explicit permission to charge the disclosed fee for this record."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fee_amount_cents",
          "confirm_fee"
        ],
        "title": "ChargeConsent"
      },
      "DraftAnswer": {
        "properties": {
          "answer": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "DraftAnswer"
      },
      "EobInfo": {
        "properties": {
          "allowed_amount": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Allowed Amount"
          },
          "patient_responsibility": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Patient Responsibility"
          },
          "deductible_applied": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Deductible Applied",
            "default": 0.0
          },
          "coinsurance": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Coinsurance",
            "default": 0.0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "allowed_amount",
          "patient_responsibility"
        ],
        "title": "EobInfo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LifeEvent": {
        "properties": {
          "event_type": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_type"
        ],
        "title": "LifeEvent"
      },
      "LineItem": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Code",
            "description": "CPT/HCPCS code"
          },
          "description": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Description"
          },
          "amount": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Amount"
          },
          "quantity": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Quantity",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "description",
          "amount"
        ],
        "title": "LineItem"
      },
      "OutcomeReport": {
        "properties": {
          "reduction_amount": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Reduction Amount",
            "description": "Dollar amount the user confirms their bill was reduced by"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "reduction_amount"
        ],
        "title": "OutcomeReport"
