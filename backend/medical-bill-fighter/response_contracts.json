                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "example": {
              "user_message": "That's a $100.00 reduction — nice work. My fee is 25% of that, $25.00, and it's only charged if you confirm. Want to save a card so I can collect it? It takes 30 seconds.",
              "case_id": "a1b2c3d4e5f6",
              "reduction_amount": 100.0,
              "fee_cents": 2500,
              "fee_rate": 0.25,
              "fee_disclosure": "25% of a documented reduction you confirm. No reduction, no fee.",
              "next": "POST /api/cases/{id}/billing/setup to save a card, then POST /api/cases/{id}/reduction-confirmed to be charged.",
