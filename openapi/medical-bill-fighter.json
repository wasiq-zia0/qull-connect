      }
    },
    "/api/cases/{case_id}/billing/setup": {
      "post": {
        "summary": "Billing Setup",
        "description": "Create the Stripe customer + SetupIntent.\n\nHONEST FEE DISCLOSURE (shown BEFORE any card is saved):\nthe response states the exact fee terms in plain language.",
        "operationId": "billing_setup_api_cases__case_id__billing_setup_post",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Case Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Billing Setup Api Cases  Case Id  Billing Setup Post"
