                      "type": "string"
                    },
                    "user_message": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                },
                "example": {
                  "ok": true,
                  "service": "401k-match",
                  "version": "0.1.0",
                  "user_message": "401(k) Match Finder is up and running."
