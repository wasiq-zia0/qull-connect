          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "ok": {
                  "type": "boolean"
                },
                "service": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                },
                "user_message": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "example": {
              "ok": true,
              "service": "401k-match",
              "version": "0.1.0",
              "user_message": "401(k) Match Finder is up and running."
            }
          }
        }
      }
    }
  },
  "/api/plans": {
    "post": {
      "201": {
        "description": "Creates a full-year educational match illustration. The paid pack remains locked; no payroll changes are made.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "plan_id": {
                  "type": "string"
                },
                "paid": {
                  "type": "boolean"
                },
                "pack_locked": {
                  "type": "boolean"
                },
                "uncaptured_match_annual": {
                  "type": "number"
                },
                "current_employer_match": {
                  "type": "number"
                },
                "max_annual_employer_match": {
                  "type": "number"
                },
                "recommended_contrib_pct": {
                  "type": "number"
                },
                "projected_annual_gain": {
                  "type": "number"
                },
                "user_message": {
                  "type": "string"
                },
                "disclaimer": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "example": {
              "plan_id": "a1b2c3d4e5f6",
              "paid": false,
              "pack_locked": true,
              "uncaptured_match_annual": 1200.0,
              "current_employer_match": 2400.0,
              "max_annual_employer_match": 3600.0,
              "recommended_contrib_pct": 6.0,
              "projected_annual_gain": 1200.0,
              "user_message": "Ran your numbers: at 4.0% you're capturing $2,400 of your $3,600 possible match — leaving $1,200 a year on the table. The modeled minimum match-capture rate is 6.0% ($276.92 per paycheck). Confirm your plan rules before changing contributions. Want the full step-by-step fix plan? It's a one-time $99, charged once after you confirm — just say the word.",
              "disclaimer": "Educational/financial-education tool only — NOT financial advice. Confirm your match formula, vesting, and contribution rules with your plan administrator before changing anything."
            }
          }
        }
      }
    }
  },
