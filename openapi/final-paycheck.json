              }
            ],
            "title": "Termination Type"
          },
          "wages_owed": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMaximum": 10000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Wages Owed"
          },
          "next_payday": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Payday"
          },
          "forwarding_address": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Forwarding Address"
          }
        },
        "type": "object",
        "title": "ConfirmDraft",
        "description": "One-tap activation of a draft case; fill any fields still missing."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Intake": {
        "properties": {
          "employee_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Employee Name"
          },
          "employee_email": {
            "type": "string",
            "maxLength": 120,
            "title": "Employee Email",
            "default": ""
          },
          "employer_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Employer Name"
          },
          "employer_address": {
            "type": "string",
            "maxLength": 500,
            "title": "Employer Address",
            "default": ""
          },
          "state": {
            "type": "string",
            "maxLength": 2,
            "minLength": 2,
            "title": "State"
          },
          "last_day_worked": {
            "type": "string",
            "format": "date",
            "title": "Last Day Worked"
          },
          "termination_type": {
            "type": "string",
            "title": "Termination Type"
          },
          "wages_owed": {
            "type": "number",
            "exclusiveMaximum": 10000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Wages Owed"
          },
          "pay_period": {
            "type": "string",
            "maxLength": 80,
            "title": "Pay Period",
            "default": ""
          },
          "next_payday": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Payday"
          },
          "forwarding_address": {
            "type": "string",
            "maxLength": 500,
            "title": "Forwarding Address",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "employee_name",
          "employer_name",
          "state",
          "last_day_worked",
          "termination_type",
          "wages_owed"
        ],
        "title": "Intake"
      },
      "LifeEvent": {
        "properties": {
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "event_type"
        ],
        "title": "LifeEvent"
      },
      "RecoveryConfirmed": {
        "properties": {
          "amount": {
            "type": "number",
            "exclusiveMaximum": 10000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          }
        },
        "type": "object",
        "required": [
          "amount"
        ],
        "title": "RecoveryConfirmed"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
