              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Report Outcome Api Cases  Case Id  Outcome Post"
                }
              }
            }
          },
          "422": {
