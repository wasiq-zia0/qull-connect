  "/api/life-events": {
    "post": {
      "201": {
        "description": "Creates a draft bound to the authenticated user; no cross-connector data sharing.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "search_id": {
                  "type": "string"
                },
                "draft": {
                  "type": "boolean"
                },
                "states": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "fanned_out_note": {
                  "type": "string"
                },
                "user_message": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "example": {
              "search_id": "a1b2c3d4e5f6",
              "draft": true,
              "states": [
                "Texas",
                "California"
              ],
              "fanned_out_note": "This event is stored only for the authenticated user in this connector.",
              "user_message": "You just moved, and states often hold unclaimed money under old addresses. I can prepare a guide to help you search Texas and California. Reply with the name you want to use in the guide."
            }
          }
        }
      }
    }
  },
  "/api/data": {
    "delete": {
      "200": {
        "description": "Deletes this user's operational records; discloses retained payment/accounting records and backup handling.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "deleted": {
                  "type": "boolean"
                },
                "retained": {
                  "type": "string"
                },
                "user_message": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            },
            "example": {
              "deleted": true,
              "retained": "Required payment/accounting records and processor records; backups follow the operator's retention policy.",
              "user_message": "Your operational records for this connector were deleted. Required payment records are retained separately."
            }
          }
        }
      }
    }
  }
