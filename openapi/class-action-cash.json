  "components": {
    "schemas": {
      "BillingSetupRequest": {
        "properties": {
          "accept_fee_terms": {
            "type": "boolean",
            "const": true,
            "title": "Accept Fee Terms",
            "description": "The user accepted the disclosed fee terms before opening Stripe checkout."
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accept_fee_terms",
          "name"
        ],
        "title": "BillingSetupRequest"
      },
      "ClaimPackRequest": {
        "properties": {
          "eligibility_confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Eligibility Confirmed"
          },
          "full_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Full Name",
            "default": ""
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Email",
            "default": ""
          },
          "address": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Address",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "eligibility_confirmed"
        ],
        "title": "ClaimPackRequest"
      },
      "DeleteDataIn": {
        "properties": {
          "confirm_delete": {
            "type": "boolean",
            "const": true,
            "title": "Confirm Delete",
            "description": "The user explicitly confirms deleting their local records and generated documents."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirm_delete"
        ],
        "title": "DeleteDataIn"
      },
      "FeeQuoteIn": {
        "properties": {
          "amount": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount",
            "description": "The actual recovered amount to quote; this operation does not charge."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount"
        ],
        "title": "FeeQuoteIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LifeEventRequest": {
        "properties": {
          "event_type": {
            "type": "string",
            "maxLength": 100,
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_type"
        ],
        "title": "LifeEventRequest"
      },
      "PayoutConfirmRequest": {
        "properties": {
          "confirm_fee": {
            "type": "boolean",
            "const": true,
            "title": "Confirm Fee",
            "description": "The user explicitly approved this exact fee after reviewing it."
          },
          "fee_amount_cents": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 1.0,
            "title": "Fee Amount Cents",
            "description": "The exact disclosed fee approved by the user, in cents."
          },
          "amount": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount",
            "description": "Confirmed payout received, in dollars"
          },
          "currency": {
            "type": "string",
            "const": "USD",
            "title": "Currency",
            "default": "USD"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirm_fee",
          "fee_amount_cents",
          "amount"
        ],
        "title": "PayoutConfirmRequest"
      },
      "ReceiptIn": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 120,
            "title": "Id",
            "default": ""
          },
          "sender": {
            "type": "string",
            "maxLength": 300,
            "title": "Sender",
            "default": ""
          },
          "subject": {
            "type": "string",
            "maxLength": 500,
            "title": "Subject",
            "default": ""
          },
          "date": {
            "type": "string",
            "maxLength": 40,
            "title": "Date",
            "default": ""
          },
          "snippet": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Snippet"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "snippet"
        ],
        "title": "ReceiptIn"
      },
      "ScanRequest": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "receipts",
              "fixtures"
            ],
            "title": "Source",
            "default": "receipts"
          },
          "receipts": {
            "items": {
              "$ref": "#/components/schemas/ReceiptIn"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Receipts"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ScanRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "UserApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Qull per-user API key",
        "description": "An operator-provisioned opaque API key belonging to one customer. Never use a Stripe secret key here."
      }
    }
  },
  "security": [
    {
      "UserApiKey": []
    }
  ]
}
