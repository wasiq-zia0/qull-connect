    "/api/claims/{cid}/payout-confirmed": {
      "post": {
        "summary": "Payout Confirmed",
        "description": "User confirms the airline paid out: charge the 30% contingency fee off-session.\n\nQuote and approve 30% of the actual EUR payout. Partial payouts are\naccepted up to the stored preliminary compensation tier; larger amounts\nrequire review. The exact fee amount and affirmative approval are required.",
        "operationId": "payout_confirmed_api_claims__cid__payout_confirmed_post",
        "parameters": [
          {
            "name": "cid",
            "in": "path",
            "required": true,
            "schema": {
