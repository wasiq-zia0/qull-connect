  "components": {
    "schemas": {
      "CaseIn": {
        "properties": {
          "tenant_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Tenant Name"
          },
          "tenant_forwarding_address": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Tenant Forwarding Address"
          },
          "state": {
            "type": "string",
            "maxLength": 2,
            "minLength": 2,
            "title": "State",
            "description": "US state abbreviation"
          },
          "move_out": {
            "type": "string",
            "format": "date",
            "title": "Move Out"
          },
          "forwarding_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Forwarding Date"
          },
          "deposit": {
            "type": "number",
            "maximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Deposit"
          },
          "landlord_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Landlord Name"
          },
          "landlord_address": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Landlord Address"
          },
          "rental_address": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Rental Address"
          }
        },
        "type": "object",
        "required": [
          "tenant_name",
          "tenant_forwarding_address",
          "state",
          "move_out",
          "deposit",
          "landlord_name",
          "landlord_address",
          "rental_address"
        ],
        "title": "CaseIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LetterStatusIn": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "sent-confirmed-by-user"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "LetterStatusIn",
        "description": "The user reviews the prepared demand letter, then confirms it was sent."
      },
      "LifeEventIn": {
        "properties": {
          "event_type": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "event_type"
        ],
        "title": "LifeEventIn"
      },
      "PromoteIn": {
        "properties": {
          "tenant_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Name"
          },
          "tenant_forwarding_address": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Tenant Forwarding Address"
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "move_out": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Move Out"
          },
          "forwarding_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Forwarding Date"
          },
          "deposit": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Deposit"
          },
          "landlord_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Landlord Name"
          },
          "landlord_address": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Landlord Address"
          },
          "rental_address": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 300
              },
              {
                "type": "null"
              }
            ],
            "title": "Rental Address"
          }
        },
        "type": "object",
        "title": "PromoteIn",
        "description": "Fields the agent collected conversationally to complete a draft."
      },
      "RecoveryIn": {
        "properties": {
          "amount_recovered": {
            "type": "number",
            "maximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount Recovered",
            "description": "Deposit amount the tenant got back"
          }
        },
        "type": "object",
        "required": [
          "amount_recovered"
        ],
        "title": "RecoveryIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "https://5.78.152.6.nip.io/deposit-recovery"
    }
  ]
