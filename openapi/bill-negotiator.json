{
  "openapi": "3.1.0",
  "info": {
    "title": "Bill Negotiator API",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/providers": {
      "get": {
        "summary": "Api Providers",
        "operationId": "api_providers_api_providers_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/cases": {
      "post": {
        "summary": "Api Create Case",
        "operationId": "api_create_case_api_cases_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cases/{cid}": {
      "get": {
        "summary": "Api Get Case",
        "operationId": "api_get_case_api_cases__cid__get",
        "parameters": [
          {
            "name": "cid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cases/{cid}/script": {
      "get": {
        "summary": "Api Script",
        "operationId": "api_script_api_cases__cid__script_get",
        "parameters": [
          {
            "name": "cid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cases/{cid}/outcome": {
      "post": {
        "summary": "Api Outcome",
        "description": "User reports the negotiation result. Computes documented savings:\nsavings = (old bill - new bill) x months_locked, months capped at 12.",
        "operationId": "api_outcome_api_cases__cid__outcome_post",
        "parameters": [
          {
            "name": "cid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OutcomeIn"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cases/{cid}/billing/setup": {
      "post": {
        "summary": "Api Billing Setup",
        "description": "Create the Stripe customer and a card-setup intent for the contingency fee.",
        "operationId": "api_billing_setup_api_cases__cid__billing_setup_post",
        "parameters": [
          {
            "name": "cid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cases/{cid}/billing/status": {
      "get": {
        "summary": "Api Billing Status",
        "description": "Pollable card-save status: billing_status, derived card_state, and the\nfee disclosure \u2014 the agent's signal for whether a charge can be attempted.",
        "operationId": "api_billing_status_api_cases__cid__billing_status_get",
        "parameters": [
          {
            "name": "cid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/cases/{cid}/savings-confirmed": {
      "post": {
        "summary": "Api Savings Confirmed",
        "description": "User confirms documented savings: charge the 35% fee off-session.\n\nThe fee is re-derived server-side from the STORED documented savings \u2014\nthe request carries no amount, so the caller cannot influence the charge.",
        "operationId": "api_savings_confirmed_api_cases__cid__savings_confirmed_post",
        "parameters": [
          {
            "name": "cid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Cid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/life-events": {
      "post": {
        "summary": "Api Life Events",
        "description": "Receive fan-out from the shared life-events bus. For bill_spike: create a\ndraft case (pre-fill every field the payload provides), return the proactive\nnudge as user_message plus the ready-to-use script pack \u2014 trigger \u2192 one tap \u2192 done.",
        "operationId": "api_life_events_api_life_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LifeEventIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CaseIn": {
        "properties": {
          "provider": {
            "type": "string",
            "minLength": 2,
            "title": "Provider",
            "description": "e.g. Comcast, Spectrum, AT&T, Verizon, Cox"
          },
          "service_type": {
            "type": "string",
            "title": "Service Type",
            "description": "internet, cable, phone, or bundle"
          },
          "current_monthly_bill": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Current Monthly Bill",
            "description": "Current bill in USD/month"
          },
          "prior_monthly_bill": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Prior Monthly Bill",
            "description": "What you used to pay (optional; enables spike detection)"
          },
          "promo_end_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Promo End Date",
            "description": "Contract/promotion end date (YYYY-MM-DD)"
          },
          "account_tenure_months": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Account Tenure Months",
            "description": "How long you've been a customer"
          },
          "user_name": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "User Name"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "service_type",
          "current_monthly_bill"
        ],
        "title": "CaseIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LifeEventIn": {
        "properties": {
          "event_type": {
            "type": "string",
            "minLength": 1,
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "event_type"
        ],
        "title": "LifeEventIn"
      },
      "OutcomeIn": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success",
            "description": "False if negotiation produced no savings",
            "default": true
          },
          "new_monthly_bill": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "New Monthly Bill",
            "description": "Negotiated monthly bill in USD"
          },
          "months_locked": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 36.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Months Locked",
            "description": "Months the new rate is locked"
          }
        },
        "type": "object",
        "title": "OutcomeIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "https://5.78.152.6.nip.io/bill-negotiator/api"
    }
  ]
}