  "components": {
    "schemas": {
      "BillingConsentIn": {
        "properties": {
          "accept_fee_terms": {
            "type": "boolean",
            "const": true,
            "title": "Accept Fee Terms",
            "description": "The user accepted the disclosed fee terms before opening Stripe checkout."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accept_fee_terms"
        ],
        "title": "BillingConsentIn"
      },
      "ConfirmDraft": {
        "properties": {
          "employee_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Employee Name"
          },
          "employer_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Employer Name"
          },
          "state": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2,
                "minLength": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          },
          "last_day_worked": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Day Worked"
          },
          "termination_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Termination Type"
          },
          "wages_owed": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMaximum": 10000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Wages Owed"
          },
          "next_payday": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Payday"
          },
          "forwarding_address": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Forwarding Address"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ConfirmDraft",
        "description": "One-tap activation of a draft case; fill any fields still missing."
      },
      "DeleteDataIn": {
        "properties": {
          "confirm_delete": {
            "type": "boolean",
            "const": true,
            "title": "Confirm Delete",
            "description": "The user explicitly confirms deleting their local records and generated documents."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirm_delete"
        ],
        "title": "DeleteDataIn"
      },
      "FeeQuoteIn": {
        "properties": {
          "amount": {
            "type": "number",
            "maximum": 1000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount",
            "description": "The actual recovered amount to quote; this operation does not charge."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount"
        ],
        "title": "FeeQuoteIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Intake": {
        "properties": {
          "employee_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Employee Name"
          },
          "employee_email": {
            "type": "string",
            "maxLength": 120,
            "title": "Employee Email",
            "default": ""
          },
          "employer_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Employer Name"
          },
          "employer_address": {
            "type": "string",
            "maxLength": 500,
            "title": "Employer Address",
            "default": ""
          },
          "state": {
            "type": "string",
            "maxLength": 2,
            "minLength": 2,
            "title": "State"
          },
          "last_day_worked": {
            "type": "string",
            "format": "date",
            "title": "Last Day Worked"
          },
          "termination_type": {
            "type": "string",
            "title": "Termination Type"
          },
          "wages_owed": {
            "type": "number",
            "exclusiveMaximum": 10000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Wages Owed"
          },
          "pay_period": {
            "type": "string",
            "maxLength": 80,
            "title": "Pay Period",
            "default": ""
          },
          "next_payday": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Payday"
          },
          "forwarding_address": {
            "type": "string",
            "maxLength": 500,
            "title": "Forwarding Address",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "employee_name",
          "employer_name",
          "state",
          "last_day_worked",
          "termination_type",
          "wages_owed"
        ],
        "title": "Intake"
      },
      "LifeEvent": {
        "properties": {
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_type"
        ],
        "title": "LifeEvent"
      },
      "RecoveryConfirmed": {
        "properties": {
          "confirm_fee": {
            "type": "boolean",
            "const": true,
            "title": "Confirm Fee",
            "description": "The user explicitly approved this exact fee after reviewing it."
          },
          "fee_amount_cents": {
            "type": "integer",
            "maximum": 100000000.0,
            "minimum": 1.0,
            "title": "Fee Amount Cents",
            "description": "The exact disclosed fee approved by the user, in cents."
          },
          "amount": {
            "type": "number",
            "exclusiveMaximum": 10000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "confirm_fee",
          "fee_amount_cents",
          "amount"
        ],
        "title": "RecoveryConfirmed"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "UserApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Qull per-user API key",
        "description": "An operator-provisioned opaque API key belonging to one customer. Never use a Stripe secret key here."
      }
    }
  },
  "security": [
    {
      "UserApiKey": []
    }
  ]
}
