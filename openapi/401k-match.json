  "components": {
    "schemas": {
      "BillingSetupIn": {
        "properties": {
          "accept_fee_terms": {
            "type": "boolean",
            "const": true,
            "title": "Accept Fee Terms"
          },
          "email": {
            "type": "string",
            "maxLength": 200,
            "title": "Email",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "accept_fee_terms"
        ],
        "title": "BillingSetupIn"
      },
      "ChargeConsent": {
        "properties": {
          "fee_amount_cents": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Fee Amount Cents"
          },
          "confirm_fee": {
            "type": "boolean",
            "const": true,
            "title": "Confirm Fee",
            "description": "Explicit permission to charge the disclosed fee for this record."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fee_amount_cents",
          "confirm_fee"
        ],
        "title": "ChargeConsent"
      },
      "DraftAnswerIn": {
        "properties": {
          "answer": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "DraftAnswerIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LifeEventIn": {
        "properties": {
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_type"
        ],
        "title": "LifeEventIn"
      },
      "PlanIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "description": "Plan holder name"
          },
          "salary": {
            "type": "number",
            "maximum": 360000.0,
            "exclusiveMinimum": 0.0,
            "title": "Salary",
            "description": "Annual gross salary in dollars"
          },
          "pay_frequency": {
            "type": "string",
            "enum": [
              "weekly",
              "biweekly",
              "semimonthly",
              "monthly"
            ],
            "title": "Pay Frequency"
          },
          "current_contrib_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Current Contrib Pct",
            "description": "Current per-paycheck contribution as % of salary"
          },
          "match_pct": {
            "type": "number",
            "maximum": 200.0,
            "minimum": 0.0,
            "title": "Match Pct",
            "description": "Employer match rate, e.g. 50 = matches 50% of contributions"
          },
          "match_cap_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Match Cap Pct",
            "description": "Employer matches up to this % of salary, e.g. 6"
          },
          "true_up": {
            "type": "boolean",
            "title": "True Up",
            "description": "Employer runs a year-end true-up",
            "default": false
          },
          "new_employer": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "New Employer",
            "description": "Optional: new employer name — emits a job_change event so sibling connectors can help"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "salary",
          "pay_frequency",
          "current_contrib_pct",
          "match_pct",
          "match_cap_pct"
        ],
        "title": "PlanIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "UserApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "Qull per-user API key",
        "description": "An operator-provisioned opaque API key belonging to one customer. Never use a Stripe secret key here."
      }
    }
  },
  "security": [
    {
      "UserApiKey": []
    }
  ]
}
