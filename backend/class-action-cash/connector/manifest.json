          },
          "accept_fee_terms": {
            "title": "Accept Fee Terms",
            "type": "boolean"
          },
          "email": {
            "default": "",
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "match_id",
          "name",
          "accept_fee_terms"
        ],
        "title": "setup_billingArguments",
        "type": "object"
