        "properties": {
          "match_id": {
            "title": "Match Id",
            "type": "string"
          },
          "eligibility_confirmed": {
            "title": "Eligibility Confirmed",
            "type": "boolean"
          },
          "full_name": {
            "default": "",
            "title": "Full Name",
            "type": "string"
          },
          "email": {
            "default": "",
            "title": "Email",
            "type": "string"
          },
          "address": {
            "default": "",
            "title": "Address",
            "type": "string"
          }
