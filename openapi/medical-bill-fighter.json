  },
  "components": {
    "schemas": {
      "CaseIntake": {
        "properties": {
          "patient_name": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Patient Name"
          },
          "patient_email": {
            "anyOf": [
              {
                "type": "string",
                "format": "email"
              },
              {
                "type": "null"
              }
            ],
            "title": "Patient Email"
          },
          "provider_name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Provider Name"
          },
          "bill_date": {
            "type": "string",
            "format": "date",
            "title": "Bill Date"
          },
          "billed_patient_responsibility": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Billed Patient Responsibility"
          },
          "line_items": {
            "items": {
              "$ref": "#/components/schemas/LineItem"
            },
            "type": "array",
            "maxItems": 200,
            "minItems": 1,
            "title": "Line Items"
          },
          "eob": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EobInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "insurance_plan": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Insurance Plan"
          },
          "is_emergency": {
            "type": "boolean",
            "title": "Is Emergency",
            "default": false
          },
          "is_out_of_network": {
            "type": "boolean",
            "title": "Is Out Of Network",
            "default": false
          },
          "facility_in_network": {
            "type": "boolean",
            "title": "Facility In Network",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "patient_name",
          "provider_name",
          "bill_date",
          "billed_patient_responsibility",
          "line_items"
        ],
        "title": "CaseIntake"
      },
      "DraftAnswer": {
        "properties": {
          "answer": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "answer"
        ],
        "title": "DraftAnswer"
      },
      "EobInfo": {
        "properties": {
          "allowed_amount": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Allowed Amount"
          },
          "patient_responsibility": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Patient Responsibility"
          },
          "deductible_applied": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Deductible Applied",
            "default": 0.0
          },
          "coinsurance": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Coinsurance",
            "default": 0.0
          }
        },
        "type": "object",
        "required": [
          "allowed_amount",
          "patient_responsibility"
        ],
        "title": "EobInfo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LifeEvent": {
        "properties": {
          "event_type": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "event_type"
        ],
        "title": "LifeEvent"
      },
      "LineItem": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 20,
            "minLength": 1,
            "title": "Code",
            "description": "CPT/HCPCS code"
          },
          "description": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Description"
          },
          "amount": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Amount"
          },
          "quantity": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Quantity",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "code",
          "description",
          "amount"
        ],
        "title": "LineItem"
      },
      "OutcomeReport": {
        "properties": {
          "reduction_amount": {
            "type": "number",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Reduction Amount",
            "description": "Dollar amount the user confirms their bill was reduced by"
          }
        },
        "type": "object",
        "required": [
          "reduction_amount"
        ],
        "title": "OutcomeReport"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "https://5.78.152.6.nip.io/medical-bill-fighter"
    }
  ]
}