{
  "actions_on_install": "none",
  "auth": {
    "type": "api_key",
    "header": "Authorization",
    "scheme": "Bearer",
    "description": "Operator-provisioned opaque key for one user. No OAuth or confirmed Muse identity exchange is implemented."
  },
  "description": "Match receipts you provide against the available settlement catalog and prepare a claim-information pack for you to review and file on the official site. 20% of the actual settlement payout you confirm for this service. Filing directly with a settlement administrator is free.",
  "display_name": "Class Action Cash",
  "proactive_triggers": [],
  "tools": [
    {
      "name": "list_settlements",
      "description": "List source-verified unexpired settlements; matches are only eligibility candidates.",
      "input_schema": {
        "properties": {},
        "title": "list_settlementsArguments",
        "type": "object"
      }
    },
    {
      "name": "scan_receipts",
      "description": "Match user-supplied receipt excerpts. Gmail OAuth is not implemented.",
      "input_schema": {
        "properties": {
          "receipts": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Receipts",
            "type": "array"
          },
          "source": {
            "default": "receipts",
            "title": "Source",
            "type": "string"
          }
        },
        "required": [
          "receipts"
        ],
        "title": "scan_receiptsArguments",
        "type": "object"
      }
    },
    {
      "name": "get_matches",
      "description": "",
      "input_schema": {
        "properties": {},
        "title": "get_matchesArguments",
        "type": "object"
      }
    },
    {
