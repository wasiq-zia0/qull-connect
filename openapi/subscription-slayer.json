    "/api/billing/setup": {
      "post": {
        "summary": "Setup Billing",
        "description": "Create the Stripe customer + SetupIntent. NO charge is taken here.\n\nThe honest fee disclosure is returned in the response BEFORE the user\nsaves a card, per the legal requirements for Meta review.\nRepeated setup returns 400 instead of orphaning a Stripe customer.",
        "operationId": "setup_billing_api_billing_setup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BillingSetupRequest"
              }
            }
