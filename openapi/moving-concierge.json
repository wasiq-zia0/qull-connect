{
  "openapi": "3.1.0",
  "info": {
    "title": "Moving Concierge API",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/life-events": {
      "post": {
        "summary": "Life Event",
        "description": "Receive a fanned-out life event. A 'move' creates a draft move + the proactive nudge.",
        "operationId": "life_event_api_life_events_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LifeEventIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/moves": {
      "post": {
        "summary": "Create Move",
        "description": "Intake: build the move + checklist, emit the move event to the shared bus.",
        "operationId": "create_move_api_moves_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MoveIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/moves/{move_id}": {
      "get": {
        "summary": "Get Move",
        "operationId": "get_move_api_moves__move_id__get",
        "parameters": [
          {
            "name": "move_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Move Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/moves/{move_id}/pack": {
      "get": {
        "summary": "Get Pack",
        "operationId": "get_pack_api_moves__move_id__pack_get",
        "parameters": [
          {
            "name": "move_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Move Id"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(md|pdf)$",
              "default": "md",
              "title": "Format"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/moves/{move_id}/checklist": {
      "patch": {
        "summary": "Update Checklist",
        "operationId": "update_checklist_api_moves__move_id__checklist_patch",
        "parameters": [
          {
            "name": "move_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Move Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChecklistPatch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/moves/{move_id}/billing/setup": {
      "post": {
        "summary": "Billing Setup",
        "description": "Create the Stripe customer + card SetupIntent. Honest fee disclosure BEFORE any charge.",
        "operationId": "billing_setup_api_moves__move_id__billing_setup_post",
        "parameters": [
          {
            "name": "move_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Move Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/moves/{move_id}/billing/status": {
      "get": {
        "summary": "Billing Status",
        "description": "Pollable billing state: card state + whether the $49 pack fee is settled.",
        "operationId": "billing_status_api_moves__move_id__billing_status_get",
        "parameters": [
          {
            "name": "move_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Move Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/moves/{move_id}/pay": {
      "post": {
        "summary": "Pay",
        "description": "Charge the flat $49.00 pack fee off-session against the saved card, then deliver the pack.",
        "operationId": "pay_api_moves__move_id__pay_post",
        "parameters": [
          {
            "name": "move_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Move Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChecklistItemUpdate": {
        "properties": {
          "item_id": {
            "type": "integer",
            "title": "Item Id"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "pending | done | na"
          }
        },
        "type": "object",
        "required": [
          "item_id",
          "status"
        ],
        "title": "ChecklistItemUpdate"
      },
      "ChecklistPatch": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ChecklistItemUpdate"
            },
            "type": "array",
            "minItems": 1,
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ChecklistPatch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LifeEventIn": {
        "properties": {
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          }
        },
        "type": "object",
        "required": [
          "event_type"
        ],
        "title": "LifeEventIn"
      },
      "MoveIn": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "email": {
            "type": "string",
            "maxLength": 200,
            "minLength": 3,
            "title": "Email"
          },
          "old_address": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Old Address"
          },
          "new_address": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "New Address"
          },
          "move_date": {
            "type": "string",
            "format": "date",
            "title": "Move Date"
          },
          "state": {
            "type": "string",
            "maxLength": 2,
            "minLength": 2,
            "title": "State",
            "description": "2-letter US state / DC code for the NEW address (DMV + voter rules)"
          },
          "draft_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Draft Id",
            "description": "Draft move id from POST /api/life-events to upgrade in place"
          }
        },
        "type": "object",
        "required": [
          "name",
          "email",
          "old_address",
          "new_address",
          "move_date",
          "state"
        ],
        "title": "MoveIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "https://5.78.152.6.nip.io/moving-concierge/api"
    }
  ]
}